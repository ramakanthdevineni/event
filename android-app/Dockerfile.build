FROM mingc/android-build-box:latest

WORKDIR /project
COPY . .

# Build a debug APK that can be sideloaded onto a phone.
RUN java -classpath gradle/wrapper/gradle-wrapper.jar org.gradle.wrapper.GradleWrapperMain assembleDebug --no-daemon

# Copy APK to a known path for extraction
RUN mkdir -p /out && cp app/build/outputs/apk/debug/*.apk /out/vms-debug.apk
