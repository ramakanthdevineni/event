# Copy to .env and change secrets before wider exposure.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-strong-password
DEFAULT_NEW_USER_PASSWORD=change-me-temp-password

DB_NAME=vms
DB_USERNAME=vms
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# false keeps HTTP Android WebView working; HTTPS on :8443 still gets Secure cookies via X-Forwarded-Proto.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=

LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=300000
BACKUP_INTERVAL_SECONDS=3600
