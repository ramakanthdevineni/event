# Copy to .env before running docker compose (required for secrets).
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-strong-password
DEFAULT_NEW_USER_PASSWORD=change-me-temp-password

DB_NAME=vms
DB_USERNAME=vms
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# false keeps HTTP Android WebView working; HTTPS on :8443 still gets Secure cookies via X-Forwarded-Proto.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=

LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=300000
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_COUNT=30

# Per-service DB pool size (5 services × 2 pools × this value ≈ max MySQL connections).
DB_POOL_MAX_SIZE=3
SESSION_CACHE_TTL_MS=30000
SESSION_CLEANUP_INTERVAL_MS=300000

# Optional: expose MySQL on host for local debugging only (do not use in production).
# MYSQL_PUBLISH_PORT=3306
